# database details
DB_HOST=openmu-postgres
DB_NAME=openmu
DB_USER=postgres
DB_PASS=admin
# port for webpage
WEB_PORT=8088
# server check (status lamp)
SERVER_CHECK_HOST=openmu-server
SERVER_CHECK_PORT=44406
# OpenMU API key (Admin Panel -> API keys, role Viewer) for the online players counter
SERVER_CHECK_API_KEY=
# reverse proxy (HAProxy, nginx...) allowed to pass the real visitor IP in X-Forwarded-For;
# comma separated IPs or CIDR, e.g. 172.20.0.1 - empty = no proxy, the connection IP is used
TRUSTED_PROXIES=
# set your timezone (applies for database & openmu-server) - default UTC
TIMEZ=
