# Settings of openmu-simple-web - copy to .env and fill in.

# Port of the website on this host.
WEB_PORT=8088

# Admin panel of OpenMU as seen from the website container (same Docker network).
OPENMU_API_URL=http://openmu-server:8080
# API key of the website: Admin Panel -> API keys, role "Website (selected functions only)", with the
# website functions Server status, Register accounts, Character ranking, Event schedule,
# Character profiles and Change account passwords ticked.
# It stays on the server; it is never sent to the browser.
OPENMU_API_KEY=

# Reverse proxy (HAProxy, nginx...) allowed to pass the real visitor IP in X-Forwarded-For;
# comma separated IPs or CIDR, e.g. 172.20.0.1 - empty = no proxy, the connection IP is used.
TRUSTED_PROXIES=

# Time zone of the event times, e.g. Europe/Warsaw - default UTC.
TIMEZ=
